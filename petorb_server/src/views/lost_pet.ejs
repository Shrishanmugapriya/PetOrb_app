<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🐾 PetOrb Lost Pet Recovery - <%= petName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #7B6AD9;
      --secondary: #9D8BEF;
      --light-lavender: #DCD5F8;
      --bg-lavender: #F5F3FD;
      --white: #FFFFFF;
      --primary-text: #2E2A4A;
      --secondary-text: #6B6785;
      --card-radius: 24px;
      --btn-radius: 16px;
      --shadow: 0 8px 20px rgba(123, 106, 217, 0.12);
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Outfit', sans-serif;
    }

    body {
      background: linear-gradient(135deg, var(--bg-lavender) 0%, #FFFFFF 100%);
      color: var(--primary-text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      background: var(--white);
      max-width: 480px;
      width: 100%;
      border-radius: var(--card-radius);
      box-shadow: var(--shadow);
      overflow: hidden;
      border: 1px solid rgba(123, 106, 217, 0.08);
      animation: fadeInUp 0.6s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .header {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: var(--white);
      padding: 30px 20px;
      text-align: center;
      position: relative;
    }

    .logo-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 15px;
    }

    .logo-icon {
      background: var(--white);
      color: var(--primary);
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 24px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .logo-text {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .badge {
      display: inline-block;
      background: #FF5A79;
      color: var(--white);
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      box-shadow: 0 4px 10px rgba(255, 90, 121, 0.2);
    }

    .pet-photo-wrapper {
      position: relative;
      width: 100%;
      height: 280px;
      overflow: hidden;
      background: #eaeaea;
    }

    .pet-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .content {
      padding: 24px;
    }

    .pet-name {
      font-size: 28px;
      font-weight: 800;
      color: var(--primary-text);
      margin-bottom: 4px;
    }

    .pet-breed {
      font-size: 16px;
      color: var(--secondary-text);
      margin-bottom: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .details-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 20px;
    }

    .info-card {
      background: var(--bg-lavender);
      padding: 12px;
      border-radius: 14px;
      border: 1px solid rgba(123, 106, 217, 0.05);
    }

    .info-label {
      font-size: 12px;
      color: var(--secondary-text);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
      margin-bottom: 2px;
    }

    .info-value {
      font-size: 15px;
      color: var(--primary-text);
      font-weight: 700;
    }

    .instruction-box {
      background: #FFF5F7;
      border-left: 4px solid #FF5A79;
      padding: 16px;
      border-radius: 0 14px 14px 0;
      margin-bottom: 24px;
    }

    .instruction-title {
      font-size: 14px;
      font-weight: 700;
      color: #FF5A79;
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .instruction-text {
      font-size: 14px;
      color: var(--primary-text);
      line-height: 1.5;
    }

    .contact-card {
      background: var(--white);
      border: 1px solid var(--light-lavender);
      padding: 18px;
      border-radius: 16px;
      text-align: center;
      margin-bottom: 24px;
    }

    .owner-title {
      font-size: 13px;
      color: var(--secondary-text);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .owner-name {
      font-size: 18px;
      font-weight: 700;
      color: var(--primary-text);
      margin-bottom: 2px;
    }

    .owner-phone {
      font-size: 20px;
      font-weight: 800;
      color: var(--primary);
    }

    .btn-call {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: var(--white);
      text-decoration: none;
      padding: 16px;
      border-radius: var(--btn-radius);
      font-size: 18px;
      font-weight: 700;
      box-shadow: 0 6px 15px rgba(123, 106, 217, 0.3);
      transition: all 0.2s ease-in-out;
    }

    .btn-call:hover {
      box-shadow: 0 8px 20px rgba(123, 106, 217, 0.4);
      transform: translateY(-2px);
    }

    .btn-call:active {
      transform: translateY(0);
    }

    .footer {
      text-align: center;
      margin-top: 20px;
      color: var(--secondary-text);
      font-size: 13px;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <div class="logo-container">
        <div class="logo-icon">P</div>
        <div class="logo-text">PetOrb</div>
      </div>
      <span class="badge">⚠️ Lost Pet Alert</span>
    </div>

    <div class="pet-photo-wrapper">
      <img src="<%= photo %>" alt="<%= petName %>" class="pet-photo" onerror="this.src='https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=500';">
    </div>

    <div class="content">
      <div class="pet-name"><%= petName %></div>
      <div class="pet-breed">🐾 <%= species %> • <%= breed %></div>

      <div class="details-grid">
        <div class="info-card">
          <div class="info-label">Age</div>
          <div class="info-value"><%= age %> Years Old</div>
        </div>
        <div class="info-card">
          <div class="info-label">Status</div>
          <div class="info-value" style="color: #FF5A79;">Needs Recovery</div>
        </div>
      </div>

      <div class="instruction-box">
        <div class="instruction-title">Special Instructions</div>
        <div class="instruction-text"><%= specialInstructions %></div>
      </div>

      <div class="contact-card">
        <div class="owner-title">Primary Contact</div>
        <div class="owner-name"><%= ownerName %> (Owner)</div>
        <div class="owner-phone"><%= ownerPhone %></div>
      </div>

      <a href="tel:<%= ownerPhone %>" class="btn-call">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        Call Owner Immediately
      </a>
    </div>
  </div>

  <div class="footer">
    Powered by PetOrb - AI-powered Pet Ecosystem
  </div>

</body>
</html>
